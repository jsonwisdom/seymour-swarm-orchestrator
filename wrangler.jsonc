{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seymour-swarm-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_LEDGER",
        "class_name": "TaskLedger"
      },
      {
        "name": "MISSION_STATE",
        "class_name": "MissionState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TaskLedger"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "MissionState"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "seymour-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "seymour-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  },
  "workflows": [
    {
      "name": "investigation-workflow",
      "binding": "INVESTIGATION_WORKFLOW",
      "class_name": "InvestigationWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
