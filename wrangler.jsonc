{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seymour-swarm-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_LEDGER",
        "class_name": "TaskLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TaskLedger"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "seymour-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "seymour-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  }
}
